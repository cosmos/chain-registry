{
  "$schema": "../chain.schema.json",
  "chain_name": "luxa",
  "status": "live",
  "network_type": "mainnet",
  "website": "https://luxaecosystem.xyz",
  "pretty_name": "LUXA Network",
  "chain_type": "cosmos",
  "chain_id": "luxa-1",
  "bech32_prefix": "luxa",
  "daemon_name": "luxad",
  "node_home": "$HOME/.luxa",
  "key_algos": [
    "secp256k1"
  ],
  "slip44": 118,
  "fees": {
    "fee_tokens": [
      {
        "denom": "uluxa",
        "fixed_min_gas_price": 0.01,
        "low_gas_price": 0.01,
        "average_gas_price": 0.025,
        "high_gas_price": 0.04
      }
    ]
  },
  "staking": {
    "staking_tokens": [
      {
        "denom": "uluxa"
      }
    ]
  },
  "codebase": {
    "git_repo": "https://github.com/luxaecosystem/luxa-chain",
    "recommended_version": "v1.0.0",
    "compatible_versions": [
      "v1.0.0"
    ],
    "consensus": {
      "type": "cometbft",
      "version": "0.38.12"
    },
    "sdk": {
      "type": "cosmos",
      "version": "0.50.10"
    },
    "cosmwasm": {
      "version": "0.53.0",
      "enabled": true
    }
  },
  "logo_URIs": {
    "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/luxa/images/luxa.png"
  },
  "apis": {
    "rpc": [
      {
        "address": "https://rpc.luxaecosystem.xyz",
        "provider": "LUXA Ecosystem"
      }
    ],
    "rest": [
      {
        "address": "https://api.luxaecosystem.xyz",
        "provider": "LUXA Ecosystem"
      }
    ]
  },
  "explorers": [
    {
      "kind": "LUXA Explorer",
      "url": "https://luxaecosystem.xyz/explorer.html",
      "tx_page": "https://luxaecosystem.xyz/explorer.html?tx=${txHash}",
      "account_page": "https://luxaecosystem.xyz/explorer.html?account=${accountAddress}"
    }
  ],
  "images": [
    {
      "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/luxa/images/luxa.png",
      "theme": {
        "circle": true
      }
    }
  ]
}
