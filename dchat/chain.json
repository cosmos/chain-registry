{
  "$schema": "../chain.schema.json",
  "chain_name": "dchat",
  "chain_type": "cosmos",
  "status": "live",
  "network_type": "mainnet",
  "website": "https://dchat.online",
  "pretty_name": "DChat",
  "chain_id": "messaging",
  "bech32_prefix": "dc",
  "daemon_name": "messagingd",
  "node_home": "$HOME/.messaging",
  "key_algos": [
    "secp256k1"
  ],
  "slip44": 118,
  "description": "DChat is an end-to-end encrypted messenger whose chain holds identities and payments. SHH is its native token.",
  "fees": {
    "fee_tokens": [
      {
        "denom": "udchat",
        "fixed_min_gas_price": 0.0001,
        "low_gas_price": 0.0025,
        "average_gas_price": 0.025,
        "high_gas_price": 0.04
      }
    ]
  },
  "staking": {
    "staking_tokens": [
      {
        "denom": "udchat"
      }
    ]
  },
  "codebase": {
    "consensus": {
      "type": "cometbft",
      "version": "0.38.17"
    },
    "sdk": {
      "type": "cosmos",
      "version": "0.50.13"
    },
    "ibc": {
      "type": "go",
      "version": "8.7.0"
    }
  },
  "apis": {
    "rpc": [
      {
        "address": "https://dchat.online/rpc",
        "provider": "DChat"
      }
    ],
    "rest": [
      {
        "address": "https://dchat.online/rest",
        "provider": "DChat"
      }
    ]
  },
  "explorers": [
    {
      "kind": "dchat",
      "url": "https://dchat.online/explorer",
      "tx_page": "https://dchat.online/explorer/tx/${txHash}"
    }
  ],
  "logo_URIs": {
    "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/dchat/images/shh.png",
    "svg": "https://raw.githubusercontent.com/cosmos/chain-registry/master/dchat/images/shh.svg"
  },
  "images": [
    {
      "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/dchat/images/shh.png",
      "svg": "https://raw.githubusercontent.com/cosmos/chain-registry/master/dchat/images/shh.svg",
      "theme": {
        "circle": true,
        "dark_mode": false
      }
    }
  ]
}