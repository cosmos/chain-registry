    "persistent_peers": [
      {
        "id": "ebc272824924ea1a27ea3183dd0b9ba713494f83",
        "address": "mantrachain-mainnet-peer.autostake.com:27536",
        "provider": "AutoStake 🛡️ Slash Protected"
      }
