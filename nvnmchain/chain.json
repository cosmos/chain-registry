    "rest": [
      {
        "address": "https://api.mantrachain.io",
        "provider": "NVNMCHAIN"
      }
    ],
    "grpc": [
      {
        "address": "https://grpc.mantrachain.io",
        "provider": "NVNMCHAIN"
      }
