{
  "$schema": "../../chain.schema.json",
  "chain_name": "piotestnet",
  "status": "live",
  "network_type": "testnet",
  "website": "https://explorer.piochain.online",
  "pretty_name": "PIO Testnet",
  "chain_type": "cosmos",
  "chain_id": "pio_testnet-1",
  "bech32_prefix": "pio",
  "daemon_name": "pio-noded",
  "node_home": "$HOME/.pio-noded",
  "key_algos": ["ethsecp256k1"],
  "extra_codecs": ["ethermint"],
  "slip44": 60,
  "fees": {
    "fee_tokens": [
      {
        "denom": "spio",
        "fixed_min_gas_price": 1000000000,
        "low_gas_price": 1000000000,
        "average_gas_price": 2000000000,
        "high_gas_price": 4000000000
      }
    ]
  },
  "staking": { "staking_tokens": [{ "denom": "spio" }] },
  "codebase": {
    "consensus": { "type": "cometbft", "version": "0.39.3" },
    "sdk": { "type": "cosmos", "version": "0.54.3" },
    "ibc": { "type": "go", "version": "11.0.0" }
  },
  "logo_URIs": {
    "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/testnets/piotestnet/images/pio.png",
    "svg": "https://raw.githubusercontent.com/cosmos/chain-registry/master/testnets/piotestnet/images/pio.svg"
  },
  "apis": {
    "rpc": [{ "address": "https://comet.piochain.online", "provider": "PIO" }],
    "rest": [{ "address": "https://rest.piochain.online", "provider": "PIO" }],
    "evm-http-jsonrpc": [{ "address": "https://rpc.piochain.online", "provider": "PIO" }]
  },
  "explorers": [
    {
      "kind": "PIO Explorer",
      "url": "https://explorer.piochain.online",
      "tx_page": "https://explorer.piochain.online/tx/${txHash}",
      "account_page": "https://explorer.piochain.online/address/${accountAddress}"
    }
  ],
  "images": [
    {
      "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/testnets/piotestnet/images/pio.png",
      "svg": "https://raw.githubusercontent.com/cosmos/chain-registry/master/testnets/piotestnet/images/pio.svg",
      "theme": { "dark_mode": false }
    }
  ]
}
