{
  "$schema": "../../chain.schema.json",
  "chain_name": "epixtestnet",
  "status": "live",
  "network_type": "testnet",
  "website": "https://epix.zone/",
  "pretty_name": "Epix Testnet",
  "chain_type": "cosmos",
  "chain_id": "epix_1917-1",
  "bech32_prefix": "epix",
  "daemon_name": "epixd",
  "node_home": "$HOME/.epixd",
  "key_algos": [
    "ethsecp256k1"
  ],
  "extra_codecs": [
    "ethermint"
  ],
  "slip44": 60,
  "fees": {
    "fee_tokens": [
      {
        "denom": "aepix",
        "low_gas_price": 20000000000,
        "average_gas_price": 25000000000,
        "high_gas_price": 40000000000
      }
    ]
  },
  "staking": {
    "staking_tokens": [
      {
        "denom": "aepix"
      }
    ]
  },
  "codebase": {
    "git_repo": "https://github.com/EpixZone/EpixChain",
    "recommended_version": "v0.7.1",
    "compatible_versions": [
      "v0.7.1"
    ],
    "genesis": {
      "genesis_url": "https://raw.githubusercontent.com/EpixZone/EpixChain/main/artifacts/genesis/testnet/genesis.json"
    },
    "language": {
      "type": "go",
      "version": "1.25.9"
    },
    "sdk": {
      "type": "cosmos",
      "version": "v0.54.3"
    },
    "consensus": {
      "type": "cometbft",
      "version": "v0.39.3"
    },
    "ibc": {
      "type": "go",
      "version": "v11.1.0"
    },
    "cosmwasm": {
      "enabled": false
    }
  },
  "peers": {
    "seeds": [],
    "persistent_peers": []
  },
  "apis": {
    "rpc": [
      {
        "address": "https://rpc.testnet.epix.zone",
        "provider": "Epix Testnet"
      }
    ],
    "rest": [
      {
        "address": "https://api.testnet.epix.zone",
        "provider": "Epix Testnet"
      }
    ],
    "grpc": [
      {
        "address": "https://grpc.testnet.epix.zone:443",
        "provider": "Epix Testnet"
      }
    ],
    "evm-http-jsonrpc": [
      {
        "address": "https://evmrpc.testnet.epix.zone/",
        "provider": "Epix Testnet"
      }
    ]
  },
  "explorers": [
    {
      "kind": "Epix Explorer",
      "url": "https://testnet.epix.zone/epix",
      "tx_page": "https://testnet.epix.zone/epix/tx/${txHash}"
    }
  ],
  "images": [
    {
      "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/epix/images/epix.png",
      "svg": "https://raw.githubusercontent.com/cosmos/chain-registry/master/epix/images/epix.svg"
    }
  ]
}
