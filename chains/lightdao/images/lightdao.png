<!DOCTYPE html>
<html class="ld-v2" lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LightDAO — 不靠质押生息，靠贡献分账</title>
<meta name="description" content="LightDAO：不靠质押生息，靠贡献分账。浏览器即节点,零成本贡献带宽;投资谁、收购谁,社区提案与投票说了算,每笔资金链上实时可查。">
<style>
:root{--bg:#0b0e17;--bg2:#0e1322;--card:#141a2a;--line:#232b42;--mut:#8b94ad;--txt:#e8ebf5;--acc:#7c8cff;--acc2:#c86bfa;--ok:#39d98a;--warn:#ffb454}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--txt);font:16px/1.75 -apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}
.wrap{max-width:980px;margin:0 auto;padding:0 20px}
header{position:sticky;top:0;z-index:9;background:rgba(11,14,23,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;gap:16px;height:58px;flex-wrap:wrap}
.logo{font-weight:800;font-size:19px;background:linear-gradient(90deg,var(--acc),var(--acc2));-webkit-background-clip:text;background-clip:text;color:transparent}
.nav a{color:var(--mut);text-decoration:none;font-size:14px}
.nav a:hover{color:var(--txt)}
.ctl{margin-left:auto;display:flex;gap:8px;align-items:center}
.ctl button,.ctl select{background:var(--card);color:var(--txt);border:1px solid var(--line);border-radius:9px;padding:5px 9px;font-size:13px}
section{padding:66px 0;border-bottom:1px solid var(--line)}
.k{color:var(--acc);font-size:13px;letter-spacing:.14em;font-weight:700}
h1{font-size:clamp(30px,5.4vw,50px);line-height:1.22;margin:14px 0 10px;font-weight:800}
h2{font-size:clamp(22px,3.4vw,30px);margin:12px 0 14px;font-weight:800}
p.lead{color:#c6cde4;font-size:17px;margin:10px 0}
.sub{color:var(--mut)}
.btns{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0 8px}
.btn{display:inline-block;padding:13px 22px;border-radius:12px;font-weight:700;text-decoration:none;font-size:15px}
.btn.p{background:linear-gradient(90deg,var(--acc),var(--acc2));color:#fff}
.btn.g{border:1px solid var(--line);color:var(--txt);background:var(--card)}
.badges{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.pill{font-size:13px;color:#aee9c8;border:1px solid #1d4634;background:#0e1f17;padding:5px 11px;border-radius:99px}
.stats{display:flex;gap:22px;flex-wrap:wrap;margin:22px 0 0;padding:14px 18px;background:var(--bg2);border:1px solid var(--line);border-radius:12px;font-size:14px;color:var(--mut)}
.stats b{color:var(--txt);font-size:16px;margin-right:5px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}
.person{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.person b{display:block;font-size:16px;margin-bottom:6px}
.person .no{color:var(--warn);font-weight:700}
table{width:100%;border-collapse:collapse;margin:16px 0;font-size:14.5px}
td,th{border:1px solid var(--line);padding:10px 12px;text-align:left;vertical-align:top}
th{background:var(--bg2);color:var(--mut);font-weight:600}
td.good{color:#aee9c8}
.steps{counter-reset:s;display:grid;gap:14px;margin-top:22px}
.step{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px 18px 16px;position:relative}
.step:before{counter-increment:s;content:counter(s);position:absolute;top:-14px;left:18px;width:28px;height:28px;border-radius:9px;background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:15px}
.step h3{margin:4px 0 6px;font-size:17px}
ul{margin:8px 0;padding-left:20px}li{margin:5px 0}
.risk{background:#1a1410;border:1px solid #4a3416;border-radius:14px;padding:18px;color:#f0d9b0}
.foot{padding:34px 0 60px;color:var(--mut);font-size:13px}
.foot a{color:var(--acc)}
@media(max-width:760px){.grid3{grid-template-columns:1fr}.nav a.hide-s{display:none}}
#net{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.45}
section,footer,header{position:relative;z-index:1}
:focus-visible{outline:2px solid #4da3ff;outline-offset:3px;border-radius:6px}
.skip{position:absolute;left:-9999px;top:0}.skip:focus{left:8px;top:8px;background:#4da3ff;color:#04101f;padding:8px 14px;border-radius:8px;z-index:99}
</style>
<script src="/js/index_1.js?v=1.10.67" integrity="sha384-g8CUZOGtmzU4wpKrUeCU75oJbwM0NbUvySZh8wAKjqt+HtPZnYgrxFxVJXkt8tc6" crossorigin="anonymous"></script>
<script src="/js/go.js?v=1.10.67" integrity="sha384-ieH6YudAuEPKt8/oEvSkWzINqi6hSQa0TDoI1b1gKKjyioNPN/MTYTxPPRPnmUfn" crossorigin="anonymous"></script>
<script src="/js/wfix.js?v=1.10.67" integrity="sha384-3YmhFo8XgiBYr4lDUSIT/JZpXWEYntFFBK7PFI5HXnIJWwThaEoh7ihjixezX1oh" crossorigin="anonymous"></script>
