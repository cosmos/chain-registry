{
  "$schema": "../chain.schema.json",
  "chain_name": "blakiston",
  "status": "live",
  "network_type": "mainnet",
  "website": "https://blakiston.org",
  "pretty_name": "Blakiston",
  "chain_type": "cosmos",
  "chain_id": "blakiston",
  "bech32_prefix": "bs9",
  "daemon_name": "blakistond",
  "node_home": "$HOME/.blakiston",
  "key_algos": [
    "secp256k1"
  ],
  "slip44": 118,
  "fees": {
    "fee_tokens": [
      {
        "denom": "tln",
        "fixed_min_gas_price": 0.0005,
        "low_gas_price": 0.0005,
        "average_gas_price": 0.0006,
        "high_gas_price": 0.0008
      }
    ]
  },
  "staking": {
    "staking_tokens": [
      {
        "denom": "tln"
      }
    ]
  },
  "codebase": {
    "recommended_version": "v1.1.0",
    "compatible_versions": [
      "v1.1.0"
    ],
    "sdk": {
      "type": "cosmos",
      "version": "v0.50.10"
    },
    "consensus": {
      "type": "cometbft",
      "version": "v0.38.12"
    },
    "cosmwasm": {
      "version": "v0.51.0",
      "enabled": true
    },
    "ibc": {
      "type": "go",
      "version": "v8.5.1",
      "ics_enabled": [
        "ics20-1"
      ]
    },
    "genesis": {
      "genesis_url": "https://dl.blakiston.org/genesis.json"
    }
  },
  "description": "Blakiston is a Cosmos SDK Layer 1 for real-world money: offline payments, on-chain gold and silver priced by a native oracle, and proof-of-existence for documents. Fixed supply of 2,100,000,000 TLN with 0% inflation.",
  "logo_URIs": {
    "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/blakiston/images/blakiston.png",
    "svg": "https://raw.githubusercontent.com/cosmos/chain-registry/master/blakiston/images/blakiston.svg"
  },
  "images": [
    {
      "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/blakiston/images/blakiston.png",
      "svg": "https://raw.githubusercontent.com/cosmos/chain-registry/master/blakiston/images/blakiston.svg",
      "theme": {
        "circle": true,
        "dark_mode": true
      }
    }
  ],
  "apis": {
    "rpc": [
      {
        "address": "https://rpc.blakiston.org",
        "provider": "Blakiston"
      }
    ],
    "rest": [
      {
        "address": "https://api.blakiston.org",
        "provider": "Blakiston"
      }
    ]
  },
  "explorers": [
    {
      "kind": "Blakiston Explorer",
      "url": "https://blakiston.org",
      "tx_page": "https://blakiston.org/tx/${txHash}"
    }
  ]
}
